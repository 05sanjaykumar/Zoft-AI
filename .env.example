# Copy to .env and fill in. Never commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# --- Speech-to-text (NVIDIA nemotron-asr-streaming) ---
NVIDIA_API_KEY=

# --- Text-to-speech (Kokoro, runs locally; needs espeak-ng) ---
KOKORO_DEFAULT_VOICE=af_heart

# --- Turn-taking ---
# Seconds of silence before the caller's turn counts as finished.
USER_SPEECH_TIMEOUT=0.8

# --- Telephony (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 form, e.g. +14155550123
TWILIO_PHONE_NUMBER=
# Public host Twilio can reach, no scheme, e.g. abc123.ngrok-free.app
PUBLIC_HOST=

# Measurement only: dual-channel recording at Twilio for the telephony round trip
# in the latency report ($0.0025/min). Leave false for normal calls.
TWILIO_DUAL_RECORDING=false

# --- Storage (optional) ---
# DATA_DIR=./data
# CLINIC_DB_PATH=./data/clinic.db
